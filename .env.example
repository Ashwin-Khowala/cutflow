# CutFlow environment variables
# Copy this to .env and fill in your keys

# ==========================================
# Option 1: Groq (Recommended - Ultra Fast)
# Free API key at: https://console.groq.com/keys
# Active Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b, groq/compound
# ==========================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================
# Option 2: Google Gemini
# Free API key at: https://aistudio.google.com/apikey
# Models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
